{
  "name": "mdm-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "start": "bun run db:migrate && bun src/index.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate"
  },
  "dependencies": {
    "drizzle-orm": "^0.44",
    "hono": "^4",
    "jose": "^6.2.12",
    "node-forge": "^1.4.0",
    "plist": "^5.0.0",
    "postgres": "^3",
    "qrcode": "^1.5.4",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/node-forge": "^1.3.14",
    "@types/qrcode": "^1.5.6",
    "drizzle-kit": "^0.31",
    "typescript": "^5"
  }
}
